{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:local": "node scripts/run-tests.mjs",
    "check:syntax": "node scripts/check-syntax.mjs",
    "check:imports": "node scripts/check-imports.mjs",
    "check:types": "node scripts/check-types.mjs",
    "check:all": "npm run check:syntax && npm run check:imports && npm run check:types && npm run test:local"
  },
  "dependencies": {
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "eslint": "^9.0.0",
    "eslint-config-preact": "^2.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-preact": "^0.1.0",
    "globals": "^15.0.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "typescript": "~5.7.0",
    "typescript-eslint": "^8.74.0",
    "vite": "^5.4.21",
    "vitest": "^2.0.0"
  }
}
